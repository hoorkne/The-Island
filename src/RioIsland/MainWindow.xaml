<Window x:Class="RioIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Island" Height="56" Width="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="12" Foreground="#F5F5F7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
  <Window.Resources>
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="#222225"/>
      <Setter Property="Foreground" Value="#EEEEF0"/>
      <Setter Property="BorderBrush" Value="#18FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="15" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#363639"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A4DCC8"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#45454A"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionCaption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8B8B95"/>
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <!-- Flat template avoids the default continuously animated progress highlight. -->
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#A4DCC8"/>
      <Setter Property="Background" Value="#27272B"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                      CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- Static layered strokes create a quiet glow without blur shaders or a render loop. -->
  <Border Margin="3" BorderThickness="1" CornerRadius="27" BorderBrush="#102ED9A3">
    <Border x:Name="IslandShell" BorderThickness="1" CornerRadius="26">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#4CFFFFFF" Offset="0"/>
          <GradientStop Color="#16FFFFFF" Offset="0.45"/>
          <GradientStop Color="#208CC5B4" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
          <GradientStop Color="#FC19191B" Offset="0"/>
          <GradientStop Color="#FE050506" Offset="0.45"/>
          <GradientStop Color="#FC0C0C0E" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="Header" Margin="17,0" Background="Transparent"
              MouseLeftButtonUp="CompactView_MouseLeftButtonUp" Cursor="Hand">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="30"/>
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="Mascot" Orientation="Horizontal" VerticalAlignment="Center"
                      ToolTip="Hello from The Island" AutomationProperties.Name="Eye mascot">
            <Border Width="7" Height="13" CornerRadius="3.5" Background="#D8F5EA" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="LeftEye"/></Border.RenderTransform>
            </Border>
            <Border Width="7" Height="13" Margin="6,0,0,0" CornerRadius="3.5" Background="#D8F5EA" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="RightEye"/></Border.RenderTransform>
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="The Island" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock x:Name="CompactStatus" Text="A little space for your day"
                       Foreground="#92929C" FontSize="10" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button x:Name="CollapseButton" Grid.Column="2" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets"
                  Style="{StaticResource PillButton}" Padding="0" Width="28" Height="28"
                  Visibility="Collapsed" Click="ClosePanel_Click" ToolTip="Collapse" AutomationProperties.Name="Collapse"/>
        </Grid>

        <ScrollViewer x:Name="ExpandedView" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="18,2,18,14"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border CornerRadius="18" BorderThickness="1" BorderBrush="#16FFFFFF" Padding="14" Margin="0,0,0,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF232326" Offset="0"/>
                  <GradientStop Color="#FF121214" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Width="64" Height="64" CornerRadius="12" Background="#303034" VerticalAlignment="Top">
                    <Grid>
                      <TextBlock x:Name="ArtworkFallback" Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="25" Foreground="#AEAFB7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Image x:Name="TrackArtwork" Width="64" Height="64" Stretch="UniformToFill"
                             RenderOptions.BitmapScalingMode="LowQuality">
                        <Image.Clip><RectangleGeometry Rect="0,0,64,64" RadiusX="12" RadiusY="12"/></Image.Clip>
                      </Image>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="SongTitle" Text="No media playing" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SongArtist" Text="Play music in a Windows media app" Foreground="#9B9BA5" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                      <Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PillButton}" Width="40" Padding="0" Click="Previous_Click" ToolTip="Previous" AutomationProperties.Name="Previous track" IsEnabled="False"/>
                      <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PillButton}" Width="48" Padding="0" Margin="7,0" Click="PlayPause_Click" ToolTip="Play / pause" AutomationProperties.Name="Play or pause" IsEnabled="False"/>
                      <Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource PillButton}" Width="40" Padding="0" Click="Next_Click" ToolTip="Next" AutomationProperties.Name="Next track" IsEnabled="False"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <ProgressBar x:Name="TrackProgress" Height="3" Margin="0,14,0,6" Maximum="1" AutomationProperties.Name="Track progress"/>
                <DockPanel>
                  <TextBlock x:Name="ElapsedText" Text="--:--" FontSize="10" Foreground="#93939D"/>
                  <TextBlock x:Name="DurationText" Text="--:--" FontSize="10" Foreground="#93939D" HorizontalAlignment="Right"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="85"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="LYRICS" Style="{StaticResource SectionCaption}"/>
                <TextBlock x:Name="LyricsText" Text="Load a local .lrc for this track" Foreground="#D8EDE5" FontSize="12"
                           TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Load .lrc" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="LoadLyrics_Click"/>
            </Grid>

            <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,12"/>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="FOCUS" Style="{StaticResource SectionCaption}"/>
                <TextBlock x:Name="TimerText" Text="25:00" FontSize="25" FontWeight="Light"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TimerButton" Content="Start" Style="{StaticResource PillButton}" Click="Timer_Click" Margin="0,0,7,0"/>
                <Button Content="Reset" Style="{StaticResource PillButton}" Click="ResetTimer_Click"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="CpuText" Text="CPU" Foreground="#A1A1AC" FontSize="10"/>
                <ProgressBar x:Name="CpuBar" Height="3" Margin="0,7,0,0" Maximum="100"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock x:Name="RamText" Text="RAM" Foreground="#A1A1AC" FontSize="10"/>
                <ProgressBar x:Name="RamBar" Height="3" Margin="0,7,0,0" Maximum="100" Foreground="#ADB8D6"/>
              </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,13">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="CLIPBOARD" Style="{StaticResource SectionCaption}"/>
                <TextBlock x:Name="ClipboardText" Text="Capture only when you choose" FontSize="11" Foreground="#B9B9C1" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Capture" Style="{StaticResource PillButton}" Click="CaptureClipboard_Click"/>
                <Button Content="Restore" Style="{StaticResource PillButton}" Margin="6,0,0,0" Click="RestoreClipboard_Click"/>
              </StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="FILE SHELF · DROP HERE" Style="{StaticResource SectionCaption}"/>
                <TextBlock x:Name="ShelfText" Text="No file dropped" FontSize="11" Foreground="#B9B9C1" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Clear" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="ClearShelf_Click"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</Window>
